// -------------------------
// VARIABLE SETUP
// -------------------------

// Head moves side to side (x-axis)
var headX = 250;
var headY = 120;
var headDirection = 2;

// Body moves up and down (y-axis)
var bodyX = 200;
var bodyY = 220;
var bodyDirection = 1.5;

// Left eye moves up and down (y-axis)
var leftEyeY = 85;
var leftEyeDirection = 1;

// Right eye moves side to side (x-axis)
var rightEyeX = 285;
var rightEyeDirection = 1.8;

// Heart moves diagonally (x + y)
var heartX = 250;
var heartY = 380;
var heartXDirection = 2;
var heartYDirection = 2;

// Title animation variables
var size = 22;
var count = 0;
var sizeDirection = 1.5;

function setup() {
  createCanvas(500, 600);
}

function draw() {
  background(175, 130, 200);

  // -------------------------
  // TITLE TEXT
  // -------------------------
  fill(255);
  textSize(size);
  textAlign(CENTER);
  text("Grace Simonich", width / 2, 60);

  // Animate title size
  size += sizeDirection;
  count++;
  if (count > 5) {
    sizeDirection *= -1;
    count = 0;
  }

  // -------------------------
  // HEAD (moves along x-axis)
  // -------------------------
  fill(255, 220, 120);
  circle(headX, headY, 160);
  headX += headDirection;
  if (headX >= 420 || headX <= 80) {
    headDirection *= -1;
  }

  // -------------------------
  // EYES
  // -------------------------
  fill(0);
  // Left eye (moves up/down)
  circle(215, leftEyeY, 15);
  leftEyeY += leftEyeDirection;
  if (leftEyeY >= 95 || leftEyeY <= 75) {
    leftEyeDirection *= -1;
  }

  // Right eye (moves side to side)
  circle(rightEyeX, 85, 15);
  rightEyeX += rightEyeDirection;
  if (rightEyeX >= 295 || rightEyeX <= 275) {
    rightEyeDirection *= -1;
  }

  // -------------------------
  // MOUTH
  // -------------------------
  fill(255, 100, 150);
  ellipse(250, 150, 40, 20);

  // -------------------------
  // HAIR
  // -------------------------
  stroke(60, 40, 20);
  strokeWeight(6);
  line(160, 40, 200, 90);
  line(300, 90, 340, 40);
  strokeWeight(1);

  // -------------------------
  // BODY (moves along y-axis)
  // -------------------------
  fill(90, 130, 255);
  rect(bodyX, bodyY, 100, 160, 20);
  bodyY += bodyDirection;
  if (bodyY >= 300 || bodyY <= 180) {
    bodyDirection *= -1;
  }

  // -------------------------
  // ARMS + LEGS
  // -------------------------
  fill(90, 130, 255);
  rect(150, bodyY + 20, 40, 15); // left arm
  rect(310, bodyY + 20, 40, 15); // right arm
  rect(220, bodyY + 150, 15, 50); // left leg
  rect(265, bodyY + 150, 15, 50); // right leg

  // -------------------------
  // HEART (moves diagonally)
  // -------------------------
  noStroke();
  fill(255, 0, 0);
  heart(heartX, heartY, 20);
  heartX += heartXDirection;
  heartY += heartYDirection;
  if (heartX >= 480 || heartX <= 20) {
    heartXDirection *= -1;
  }
  if (heartY >= 580 || heartY <= 300) {
    heartYDirection *= -1;
  }
}

// -------------------------
// HELPER FUNCTION: Draw a heart shape
// -------------------------
function heart(x, y, size) {
  beginShape();
  vertex(x, y);
  bezierVertex(x - size, y - size, x - size * 1.5, y + size / 2, x, y + size);
  bezierVertex(x + size * 1.5, y + size / 2, x + size, y - size, x, y);
  endShape(CLOSE);
}
